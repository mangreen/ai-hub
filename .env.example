# AI Hub — 環境變數範例。複製成 .env 並填入真實值。.env 本身已在 .gitignore，不會被提交。
# 詳見 CLAUDE.md 4.3 節（機密管理）與 docs/adr/ADR-0003-model-provider-architecture.md。

# Ollama（本地）—— 通常不需要 API key，只有在非預設連接埠/主機時才需要改這個。
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI —— platform.openai.com
OPENAI_API_KEY=your-api-key-here

# Google Gemini —— aistudio.google.com（走官方 OpenAI-相容端點，非測試用途）
GEMINI_API_KEY=your-api-key-here

# xAI Grok —— console.x.ai
XAI_API_KEY=your-api-key-here

# NVIDIA NIM（build.nvidia.com）—— key 開頭固定是 nvapi-
NVIDIA_API_KEY=your-api-key-here

# OpenRouter —— openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here
# 以下兩個是選填，只影響 OpenRouter 排行榜歸因，不影響功能，可以不填：
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Anthropic Claude —— console.anthropic.com（走原生 Messages API，不是 OpenAI-相容測試端點，見 ADR-0003）
ANTHROPIC_API_KEY=your-api-key-here

# --- Phase 4：持久化（都是選填，不設定會用預設值）---
# SQLite 資料庫檔案路徑。預設 ./data/ai-hub.db，測試會覆寫成 :memory:。
AI_HUB_DB_PATH=
# 附件本地磁碟儲存目錄。預設 ./data/attachments。
AI_HUB_ATTACHMENTS_DIR=

